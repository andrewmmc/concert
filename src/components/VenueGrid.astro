---
import { ENGLISH, TRADITIONAL_CHINESE, getVenueText, translate } from '../lib/i18n.js';
import { venueLine } from '../lib/venueLines.js';

const { venues, compact = false } = Astro.props;
const t = (key) => translate(ENGLISH, key);
---

<div class:list={['venue-grid', { 'compact-grid': compact }]}>
  {venues.map((venue) => {
    const english = getVenueText(ENGLISH, venue);
    const chinese = getVenueText(TRADITIONAL_CHINESE, venue);
    const line = venueLine(venue.id);
    return (
      <a
        class="venue-card"
        href={`/venues/${venue.id}/`}
        style={`--line-color: ${line.color}`}
      >
        <div class="venue-card-top">
          <span class="line-chip" aria-hidden="true">{line.code}</span>
        </div>
        <div class="venue-card-copy">
          <h3 data-en={english.name} data-zh-hk={chinese.name}>{english.name}</h3>
          <span data-en={english.subtitle} data-zh-hk={chinese.subtitle}>{english.subtitle}</span>
        </div>
        <div class="venue-card-action">
          <span data-i18n="venueDetails">{t('venueDetails')}</span>
          <span aria-hidden="true">→</span>
        </div>
      </a>
    );
  })}
</div>
