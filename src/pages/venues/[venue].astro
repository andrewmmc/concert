---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ENGLISH, TRADITIONAL_CHINESE, getVenueText, translate } from '../../lib/i18n.js';
import { getVenueDetail } from '../../lib/venueDetails.js';
import { venueLine } from '../../lib/venueLines.js';
import { venues } from '../../venues/index.js';

export async function getStaticPaths() {
  const details = await getCollection('venues');
  return venues.map((venue) => ({
    params: { venue: venue.id },
    props: { venue, detail: getVenueDetail(details, venue.id) },
  }));
}

const { venue, detail } = Astro.props;
const t = (key) => translate(ENGLISH, key);
const text = getVenueText(ENGLISH, venue);
const chineseText = getVenueText(TRADITIONAL_CHINESE, venue);
const line = venueLine(venue.id);
const viewerUrl = `/viewer/${venue.id}/${venue.defaultLayout}/`;
---

<BaseLayout
  currentPage="venue"
  venueId={venue.id}
  title={`${text.name} — ${t('siteName')}`}
  titleZh={`${chineseText.name} — ${translate(TRADITIONAL_CHINESE, 'siteName')}`}
  description={detail.description}
>
  <section class="venue-profile-hero" style={`--venue-color: ${line.color}`}>
    <div class="venue-profile-grid">
      <div class="venue-profile-copy reveal">
        <a class="back-link" href="/venues/"><span aria-hidden="true">←</span> <span data-i18n="navVenues">{t('navVenues')}</span></a>
        <p class="eyebrow"><span data-i18n="arenaPageEyebrow">{t('arenaPageEyebrow')}</span> / {venue.id.toUpperCase()}</p>
        <h1 data-en={text.name} data-zh-hk={chineseText.name}>{text.name}</h1>
        <p
          class="venue-description"
          data-en={detail.description}
          data-zh-hk={detail.descriptionZh}
        >{detail.description}</p>
        <a class="button-primary venue-viewer-button" href={viewerUrl}>
          <span data-i18n="openDedicatedViewer">{t('openDedicatedViewer')}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <figure class="venue-cover reveal delay-one">
        <div class="venue-cover-media">
          <img src={detail.cover} alt="" />
          <div class="venue-cover-label">
            <span class="line-chip">{line.code}</span>
            <strong>{venue.id.toUpperCase()}</strong>
            <small>HONG KONG / 852</small>
          </div>
        </div>
        <figcaption>
          <span data-i18n="coverPreview">{t('coverPreview')}</span>
          <span aria-hidden="true">01</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="venue-guide">
    <section class="venue-info-section" aria-labelledby="opening-hours">
      <header class="venue-section-heading">
        <span>01 / 04</span>
        <h2 id="opening-hours" data-i18n="openingHours">{t('openingHours')}</h2>
      </header>
      <div class="venue-section-body venue-table-layout">
        <p
          class="venue-section-lead"
          data-en={detail.openingHoursIntro}
          data-zh-hk={detail.openingHoursIntroZh}
        >{detail.openingHoursIntro}</p>
        <dl class="venue-detail-table">
          {detail.openingHours.map((item) => (
            <div>
              <dt data-en={item.label} data-zh-hk={item.labelZh}>{item.label}</dt>
              <dd data-en={item.value} data-zh-hk={item.valueZh}>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="venue-info-section" aria-labelledby="transport">
      <header class="venue-section-heading">
        <span>02 / 05</span>
        <h2 id="transport" data-i18n="arenaTransportTitle">{t('arenaTransportTitle')}</h2>
      </header>
      <div class="venue-section-body venue-table-layout">
        <p
          class="venue-section-lead"
          data-en={detail.transport}
          data-zh-hk={detail.transportZh}
        >{detail.transport}</p>
        <dl class="venue-detail-table">
          {detail.transportMethods.map((item) => (
            <div>
              <dt data-en={item.label} data-zh-hk={item.labelZh}>{item.label}</dt>
              <dd data-en={item.value} data-zh-hk={item.valueZh}>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="venue-info-section" aria-labelledby="address-map">
      <header class="venue-section-heading">
        <span>03 / 05</span>
        <h2 id="address-map" data-i18n="addressAndMap">{t('addressAndMap')}</h2>
      </header>
      <div class="venue-section-body venue-map-layout">
        <div>
          <p class="venue-address-label" data-i18n="venueAddress">{t('venueAddress')}</p>
          <address
            class="venue-address"
            data-en={detail.address}
            data-zh-hk={detail.addressZh}
          >{detail.address}</address>
          <p
            class="venue-section-note"
            data-en={detail.mapNote}
            data-zh-hk={detail.mapNoteZh}
          >{detail.mapNote}</p>
          <a class="venue-map-link" href={detail.mapUrl} target="_blank" rel="noreferrer">
            <span data-i18n="openInOpenStreetMap">{t('openInOpenStreetMap')}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="venue-map">
          <iframe
            src={detail.mapEmbedUrl}
            title={`OpenStreetMap preview for ${text.name}`}
            loading="lazy"
            referrerpolicy="no-referrer"
          ></iframe>
          <span>© OpenStreetMap</span>
        </div>
      </div>
    </section>

    <section class="venue-info-section" aria-labelledby="facilities">
      <header class="venue-section-heading">
        <span>04 / 05</span>
        <h2 id="facilities" data-i18n="venueFacilities">{t('venueFacilities')}</h2>
      </header>
      <div class="venue-section-body">
        <p
          class="venue-section-lead venue-facilities-intro"
          data-en={detail.facilitiesIntro}
          data-zh-hk={detail.facilitiesIntroZh}
        >{detail.facilitiesIntro}</p>
        <ul class="venue-facilities-list">
          {detail.facilities.map((facility, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3 data-en={facility.title} data-zh-hk={facility.titleZh}>{facility.title}</h3>
              <p data-en={facility.description} data-zh-hk={facility.descriptionZh}>{facility.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="venue-info-section venue-album-section" aria-labelledby="photo-album">
      <header class="venue-section-heading">
        <span>05 / 05</span>
        <h2 id="photo-album" data-i18n="photoAlbum">{t('photoAlbum')}</h2>
      </header>
      <div class="venue-section-body">
        <p
          class="venue-section-lead"
          data-en={detail.galleryIntro}
          data-zh-hk={detail.galleryIntroZh}
        >{detail.galleryIntro}</p>
        <div class="venue-gallery">
          {detail.gallery.map((photo, index) => (
            <figure>
              <div class="venue-gallery-image">
                <img src={photo.image} alt="" loading="lazy" />
                <span>{String(index + 1).padStart(2, '0')}</span>
              </div>
              <figcaption data-en={photo.caption} data-zh-hk={photo.captionZh}>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
