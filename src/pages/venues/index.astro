---
import { getEntry } from 'astro:content';
import VenueGrid from '../../components/VenueGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { venues } from '../../venues/index.js';

const entry = await getEntry('pages', 'venue-directory');
if (!entry || entry.data.type !== 'venue-directory') {
  throw new Error('Missing venue directory Markdown content');
}
const content = entry.data;
---

<BaseLayout
  currentPage="venues"
  title={`${content.title} — Hong Kong Concert Guide`}
  titleZh={`${content.titleZh} — 香港演唱會指南`}
  description={content.description}
>
  <section class="page-hero venues-hero">
    <p class="eyebrow" data-en={content.eyebrow} data-zh-hk={content.eyebrowZh}>{content.eyebrow}</p>
    <h1 data-en={content.title} data-zh-hk={content.titleZh}>{content.title}</h1>
    <p data-en={content.description} data-zh-hk={content.descriptionZh}>{content.description}</p>
  </section>
  <section class="venue-directory-page">
    <VenueGrid venues={venues} />
  </section>
</BaseLayout>
