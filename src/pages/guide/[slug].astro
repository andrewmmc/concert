---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('guidePosts');
  const englishPosts = posts
    .filter((post) => post.data.locale === 'en')
    .sort((a, b) => a.data.order - b.data.order);
  const localizedPosts = englishPosts.map((english) => {
    const chinese = posts.find((post) =>
      post.data.locale === 'zh-HK' &&
      post.data.translationKey === english.data.translationKey
    );
    if (!chinese) throw new Error(`Missing Chinese guide post: ${english.data.translationKey}`);
    return { english, chinese };
  });

  const navigation = (post) => post && ({
    slug: post.english.data.translationKey,
    title: post.english.data.title,
    titleZh: post.chinese.data.title,
  });

  return localizedPosts.map(({ english, chinese }, index) => ({
    params: { slug: english.data.translationKey },
    props: {
      english,
      chinese,
      previous: navigation(localizedPosts[index - 1]),
      next: navigation(localizedPosts[index + 1]),
    },
  }));
}

const { english, chinese, previous, next } = Astro.props;
const { Content: EnglishContent } = await render(english);
const { Content: ChineseContent } = await render(chinese);
---

<BaseLayout
  currentPage="guide"
  title={`${english.data.title} — Hong Kong Concert Guide`}
  titleZh={`${chinese.data.title} — 香港演唱會指南`}
  description={english.data.description}
>
  <article class="guide-post">
    <header class="guide-post-header">
      <a href="/guide/">
        <span aria-hidden="true">←</span>
        <span data-en="Concert-going handbook" data-zh-hk="演唱會入場手冊">Concert-going handbook</span>
      </a>
      <p class="eyebrow" data-en="Before you go" data-zh-hk="入場之前">Before you go</p>
      <h1 data-en={english.data.title} data-zh-hk={chinese.data.title}>{english.data.title}</h1>
      <p data-en={english.data.description} data-zh-hk={chinese.data.description}>{english.data.description}</p>
    </header>
    <div class="guide-post-body" data-locale-body="en">
      <EnglishContent />
    </div>
    <div class="guide-post-body" data-locale-body="zh-HK">
      <ChineseContent />
    </div>
    <nav class="guide-post-navigation" aria-label="Guide articles">
      {previous && (
        <a class="previous" href={`/guide/${previous.slug}/`}>
          <span aria-hidden="true">←</span>
          <span>
            <small data-en="Previous post" data-zh-hk="上一篇">Previous post</small>
            <strong data-en={previous.title} data-zh-hk={previous.titleZh}>{previous.title}</strong>
          </span>
        </a>
      )}
      {next && (
        <a class="next" href={`/guide/${next.slug}/`}>
          <span>
            <small data-en="Next post" data-zh-hk="下一篇">Next post</small>
            <strong data-en={next.title} data-zh-hk={next.titleZh}>{next.title}</strong>
          </span>
          <span aria-hidden="true">→</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
